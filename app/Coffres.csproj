<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Coffres</AssemblyName>
    <RootNamespace>Coffres</RootNamespace>
    <Version>1.1.2</Version>
    <NoWarn>$(NoWarn);CS8632;CS0168;CS0219;CS1998;CA1416</NoWarn>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <DebugType>none</DebugType>
    <ApplicationIcon>coffres.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\vendor\lib\FortniteReplayReader\FortniteReplayReader.csproj" />
    <Compile Include="..\vendor\src\ChestCounter\ReplayAnalyzer.cs" />
    <Compile Include="..\vendor\src\ChestCounter\Models.cs" />
    <Compile Include="..\vendor\src\ChestCounter\Lang.cs" />
    <Compile Include="..\vendor\src\ChestCounter\GameModes.cs" />
    <Compile Include="..\vendor\src\ChestCounter\TreasureCatalog.cs" />
    <Compile Include="..\vendor\src\ChestCounter\AppInfo.cs" />
    <Compile Include="..\wasm\Summary.cs" />
    <Compile Include="..\vendor\src\ChestCounter\NativeOverlay.cs" />
    <Compile Include="..\vendor\src\ChestCounter\Png.cs" />
    <EmbeddedResource Include="..\vendor\content\content.json" LogicalName="content.json" />
    <EmbeddedResource Include="..\site\index.html" LogicalName="index.html" />
    <EmbeddedResource Include="..\site\licenses.txt" LogicalName="licenses.txt" />
  </ItemGroup>
</Project>
